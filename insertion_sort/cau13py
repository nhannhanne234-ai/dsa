def base_insert(a):
    n = len(a)
    for i in range(1,n):
        key = a[i]
        j=i-1
        while j>=0:
            condition1 = (key[0] < a[j][0]) 
            condition2 = (key[0] == a[j][0]) and (key[1] < a[j][1])
            if condition1 or condition2:
                a[j+1] = a[j]
                j-=1
            else:
                break
        a[j+1]=key
    return a

a = [(2,'c'),(1,'b'),(2,'a')]
result = base_insert(a)
print(result)