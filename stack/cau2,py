class Stack:
    def __init__(self):
        self.items = []

    def push(self, item):
        self.items.append(item)

    def pop(self):
        if not self.is_empty():
            return self.items.pop()

    def is_empty(self):
        return len(self.items) == 0
    
def reverse_string(s):
    stack = Stack()

    for i in s:
        stack.push(i)

    result = ''

    while not stack.is_empty():
        result += stack.pop()
        
    return result

print(reverse_string('abc'))